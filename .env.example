# Model providers (at least one for Quick answer and natural-language synthesis)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web research providers (at least one for Research & answer)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional: force one configured search backend: tavily | brave
SUPERBRAIN_WEB_SEARCH_PROVIDER=

# Mission Control stays loopback-only by default.
# SUPERBRAIN_MISSION_CONTROL_HOST=127.0.0.1
# SUPERBRAIN_MISSION_CONTROL_PORT=8787
# SUPERBRAIN_STATE_DB=work/superbrain-state.db
# SUPERBRAIN_MISSION_CONTROL_TOKEN=

# OSINT / research sources
# Public GitHub metadata works without a token; GITHUB_TOKEN increases authenticated API access/rate limits.
GITHUB_TOKEN=
# Comma-separated: web,github,duckduckgo.
SUPERBRAIN_RESEARCH_SOURCES=web,github,duckduckgo

# Application egress: direct | http_proxy | socks5 | tor | auto
# tor uses SOCKS5 and remote-DNS semantics. Default Tor Browser/Tor daemon ports: 9150 / 9050.
# auto prefers a detected local Tor SOCKS endpoint, then a standard proxy env var, then direct.
SUPERBRAIN_EGRESS_MODE=direct
SUPERBRAIN_PROXY_HOST=127.0.0.1
SUPERBRAIN_PROXY_PORT=9150
# Optional explicit proxy URL, e.g. socks5://127.0.0.1:1080 or http://127.0.0.1:8080
SUPERBRAIN_EGRESS_PROXY=
SUPERBRAIN_EGRESS_TIMEOUT_SECONDS=10
# Explicit .onion host allowlist; do not use an open-ended dark-web crawler.
SUPERBRAIN_ONION_ALLOWLIST=

# Local privacy boundary. When enabled, Mission Control is loopback-only and API-authenticated.
SUPERBRAIN_STEALTH_MODE=1
