# Superbrain provider credentials
# Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.8-flash

# Optional provider timeout in milliseconds
SUPERBRAIN_PROVIDER_TIMEOUT_MS=60000

# SB-021 provider resilience (non-secret controls)
# SUPERBRAIN_PROVIDER_ALLOWLIST=openai,anthropic,gemini
# SUPERBRAIN_PROVIDER_MAX_ATTEMPTS=2
# SUPERBRAIN_PROVIDER_MAX_TOTAL_ATTEMPTS=6
# SUPERBRAIN_PROVIDER_ROUTER_TIMEOUT_MS=60000
# SUPERBRAIN_PROVIDER_MAX_TOTAL_LATENCY_MS=120000
# SUPERBRAIN_PROVIDER_COST_BUDGET=12
# SUPERBRAIN_PROVIDER_CIRCUIT_THRESHOLD=3
# SUPERBRAIN_PROVIDER_CIRCUIT_COOLDOWN_MS=30000
# SUPERBRAIN_PROVIDER_RATE_LIMIT=60
# SUPERBRAIN_PROVIDER_RATE_WINDOW_MS=60000
# SUPERBRAIN_LIVE_PROVIDER_SMOKE=0
